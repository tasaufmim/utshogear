# ─────────────────────────────────────────────────────────────
# UGR ERP — environment configuration
# Copy to .env and fill in. Generated secrets: see below.
# ─────────────────────────────────────────────────────────────

# --- MongoDB (local single-node replica set, started by scripts/mongo-start.sh)
MONGO_URL=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGO_DB=utsho_gear
# App connects with a RESTRICTED role (no update/remove on audit_log).
MONGO_APP_USER=utsho_app
MONGO_APP_PASS=changeme
# Privileged admin for `npm run mongo:rs-init` re-runs and backups.
# Created automatically on the first (unauthenticated) rs-init run and
# appended to .env as utshoAdmin with a random password.
MONGO_ADMIN_USER=
MONGO_ADMIN_PASS=

# --- Auth
# REQUIRED in production; auto-generated random value in dev if omitted.
JWT_SECRET=changeme
JWT_TTL_HOURS=12
IDLE_LOCK_MINUTES=5

# --- Server
PORT=4000
# NODE_ENV=production

# --- Business
BUSINESS_TZ=Asia/Dhaka

# --- Owner's remote read-only view (Phase 10):
# run a second instance against the same DB with READONLY=1 — every write
# is rejected with 403 (login/unlock/session exempt) so the owner can browse
# reports from anywhere while the shop keeps selling offline.
READONLY=0

# --- Sync to Atlas (one-way push, Phase 10 — optional)
# Local Mongo stays the source of truth; the owner's remote instance runs the
# same app with READONLY=1 against Atlas and never writes.
SYNC_ENABLED=0
ATLAS_URL=
SYNC_INTERVAL_MIN=30

# --- SMS (optional — the app is fully usable without it)
# Reminders live in-app; configuring a provider enables real sends.
# SMS_PROVIDER=bulksmsbd
# SMS_USER=
# SMS_PASS=
# SMS_API_KEY=
# SMS_SENDERID=8809612notify

# --- Seed overrides (npm run seed)
# SEED_OWNER_PHONE=01700000000
# SEED_OWNER_PIN=1234
# SEED_CASHIER_PHONE=01800000000
# SEED_CASHIER_PIN=1111
